# Stability-8, Caune et al. (arXiv:2410.05202; Nat. Commun. 17, 7383 (2026)). Noiseless.
# schedule=lep, executed on 2024-06-14 (Zenodo stability_8_without_resets_raw_data.h5).
# syndrome-extraction (measurement) rounds n=6; decoding rounds (detector layers) d=n-1=5.
# Stim index -> Ankaa-2 qubit: 0->Q36, 1->Q45, 2->Q51, 3->Q52, 4->Q38, 5->Q50, 6->Q37, 7->Q43
# ancillas Q36,Q38,Q50,Q52 measure Z37Z43, Z37Z45, Z43Z51, Z45Z51; data Q37,Q43,Q45,Q51; Q44 (centre, X-check ancilla) unused.
# QUBIT_COORDS(col,row): Ankaa-2 7-column square lattice, col = q mod 7, row = q div 7.
# SQRT_X = RX(+pi/2), SQRT_X_DAG = RX(-pi/2) (up to global phase). No resets anywhere.
QUBIT_COORDS(1, 5) 0  # Q36 ancilla
QUBIT_COORDS(3, 6) 1  # Q45 data
QUBIT_COORDS(2, 7) 2  # Q51 data
QUBIT_COORDS(3, 7) 3  # Q52 ancilla
QUBIT_COORDS(3, 5) 4  # Q38 ancilla
QUBIT_COORDS(1, 7) 5  # Q50 ancilla
QUBIT_COORDS(2, 5) 6  # Q37 data
QUBIT_COORDS(1, 6) 7  # Q43 data
# ======== syndrome-extraction round 1 / 6 ========
# Fig. 2(e): RX(-pi/2) on data, 40 ns
SQRT_X_DAG 1 2 6 7
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# Fig. 2(i): RX(-pi/2) on ancillas, 40 ns
SQRT_X_DAG 0 3 4 5
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns) then ring-down DELAY 192/336/168/144 ns; no reset
M 0 4 3 5
# logical observable: product of the four ZZ checks in round 1 = parity of the four first-round ancilla outcomes (the four checks multiply to the identity)
OBSERVABLE_INCLUDE(0) rec[-4] rec[-3] rec[-2] rec[-1]
# ======== syndrome-extraction round 2 / 6 ========
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# Fig. 2(i): RX(-pi/2) on ancillas, 40 ns
SQRT_X_DAG 0 3 4 5
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns) then ring-down DELAY 192/336/168/144 ns; no reset
M 0 4 3 5
# decoding round 1: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 0) rec[-2]  # Q52, check Z45Z51
DETECTOR(1, 7, 0) rec[-1]  # Q50, check Z43Z51
DETECTOR(3, 5, 0) rec[-3]  # Q38, check Z37Z45
DETECTOR(1, 5, 0) rec[-4]  # Q36, check Z37Z43
# ======== syndrome-extraction round 3 / 6 ========
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# Fig. 2(i): RX(-pi/2) on ancillas, 40 ns
SQRT_X_DAG 0 3 4 5
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns) then ring-down DELAY 192/336/168/144 ns; no reset
M 0 4 3 5
# decoding round 2: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 1) rec[-2] rec[-10]  # Q52, check Z45Z51
DETECTOR(1, 7, 1) rec[-1] rec[-9]  # Q50, check Z43Z51
DETECTOR(3, 5, 1) rec[-3] rec[-11]  # Q38, check Z37Z45
DETECTOR(1, 5, 1) rec[-4] rec[-12]  # Q36, check Z37Z43
# ======== syndrome-extraction round 4 / 6 ========
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# Fig. 2(i): RX(-pi/2) on ancillas, 40 ns
SQRT_X_DAG 0 3 4 5
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns) then ring-down DELAY 192/336/168/144 ns; no reset
M 0 4 3 5
# decoding round 3: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 2) rec[-2] rec[-10]  # Q52, check Z45Z51
DETECTOR(1, 7, 2) rec[-1] rec[-9]  # Q50, check Z43Z51
DETECTOR(3, 5, 2) rec[-3] rec[-11]  # Q38, check Z37Z45
DETECTOR(1, 5, 2) rec[-4] rec[-12]  # Q36, check Z37Z43
# ======== syndrome-extraction round 5 / 6 ========
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# Fig. 2(i): RX(-pi/2) on ancillas, 40 ns
SQRT_X_DAG 0 3 4 5
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns) then ring-down DELAY 192/336/168/144 ns; no reset
M 0 4 3 5
# decoding round 4: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 3) rec[-2] rec[-10]  # Q52, check Z45Z51
DETECTOR(1, 7, 3) rec[-1] rec[-9]  # Q50, check Z43Z51
DETECTOR(3, 5, 3) rec[-3] rec[-11]  # Q38, check Z37Z45
DETECTOR(1, 5, 3) rec[-4] rec[-12]  # Q36, check Z37Z43
# ======== syndrome-extraction round 6 / 6 ========
TICK
# Fig. 2(f): RX(+pi/2) on ancillas, 40 ns
SQRT_X 5 3 0 4
TICK
# Fig. 2(g): CZ Q36-Q37 Q38-Q45 Q52-Q51 Q50-Q43, 176 ns (longest CZ in layer)
CZ 0 6 4 1 3 2 5 7
TICK
# Fig. 2(h): CZ Q37-Q38 Q45-Q52 Q51-Q50 Q43-Q36, 112 ns (longest CZ in layer)
CZ 6 4 1 3 2 5 7 0
TICK
# final round: RX(-pi/2) on all 8, 40 ns
SQRT_X_DAG 0 1 2 3 4 5 6 7
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns)
M 0 4 3 5
TICK
# final readout of the data qubits Q51,Q43,Q45,Q37 (500 ns pulses), after a FENCE; not used by any detector or by the observable
M 2 7 1 6
# decoding round 5: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 4) rec[-6] rec[-14]  # Q52, check Z45Z51
DETECTOR(1, 7, 4) rec[-5] rec[-13]  # Q50, check Z43Z51
DETECTOR(3, 5, 4) rec[-7] rec[-15]  # Q38, check Z37Z45
DETECTOR(1, 5, 4) rec[-8] rec[-16]  # Q36, check Z37Z43
