M 0 4 3 5
# decoding round 5: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 4) rec[-2] rec[-10]  # Q52, check Z45Z51
DETECTOR(1, 7, 4) rec[-1] rec[-9]  # Q50, check Z43Z51
DETECTOR(3, 5, 4) rec[-3] rec[-11]  # Q38, check Z37Z45
