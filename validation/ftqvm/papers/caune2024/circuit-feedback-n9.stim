TICK
# final round: RX(+pi/2) on all 8, 40 ns
SQRT_X 0 1 2 3 4 5 6 7
TICK
# Fig. 2(j): MEASURE Q36,Q38,Q52,Q50 (pulses 984/976/952/948 ns)
M 0 4 3 5
# final readout of the data qubits Q51,Q43,Q45,Q37 (500 ns pulses), simultaneous with the ancillas; not used by any detector or by the observable
M 2 7 1 6
# decoding round 8: detector = m_r xor m_(r-2) for each ancilla (round 2: m_2 alone)
DETECTOR(3, 7, 7) rec[-6] rec[-14]  # Q52, check Z45Z51
DETECTOR(1, 7, 7) rec[-5] rec[-13]  # Q50, check Z43Z51
DETECTOR(3, 5, 7) rec[-7] rec[-15]  # Q38, check Z37Z45
DETECTOR(1, 5, 7) rec[-8] rec[-16]  # Q36, check Z37Z43
