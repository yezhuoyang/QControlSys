DETECTOR(3, 7, 5) rec[-2] rec[-10]  # Q52, check Z45Z51
DETECTOR(1, 7, 5) rec[-1] rec[-9]  # Q50, check Z43Z51
DETECTOR(3, 5, 5) rec[-3] rec[-11]  # Q38, check Z37Z45
