   "section": "Methods, Gate Sequence of Lattice Split Operation"
  },
  {
   "name": "pipelining",
   "value": "readout of one type overlaps the start of the other type",
   "quote": "During surface-code cycles, we employ a pipelined gate scheduling: a new stabilizer measurement begins before the readout step of the other stabilizer type completes.",
   "section": "Methods, Gate Sequence of Lattice Split Operation"
  },
  {
   "name": "data readout timing",
   "value": "parallel with auxiliary readout",
   "quote": "Data qubit readout, both mid-circuit during the code deformation, and the final measurement, is performed in parallel with the auxiliary-qubit readout.",
   "section": "Methods, Gate Sequence of Lattice Split Operation"
  },
  {
   "name": "no reset",
   "value": "auxiliary and data qubits are never reset after readout",
