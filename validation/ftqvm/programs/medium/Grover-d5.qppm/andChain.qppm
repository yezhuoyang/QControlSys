gadget andChain(n, anc):
  prepare |Y+> -> anc[0]
  measure Z q[anc] Z anc[0] -> m[0]
  measure X anc[0] -> m[1]
  when m[0]:
    frame Z q[anc]
  when m[1]:
    frame Z q[anc]
  prepare |Y+> -> anc[1]
  measure X q[anc] Z anc[1] -> m[2]
  measure X anc[1] -> m[3]
  when m[2]:
    frame X q[anc]
  when m[3]:
    frame X q[anc]
  frame Z q[anc]
  prepare |T> -> anc[2]
  measure Z q[0] Z anc[2] -> m[4]
  measure X anc[2] -> m[5]
  when m[5]:
    frame Z q[0]
  when m[4]:
    prepare |Y+> -> anc[3]
    measure Z q[0] Z anc[3] -> m[6]
    measure X anc[3] -> m[7]
    when m[6]:
      frame Z q[0]
    when m[7]:
      frame Z q[0]
  prepare |T> -> anc[5]
  measure Z q[1] Z anc[5] -> m[8]
  measure X anc[5] -> m[9]
  when m[9]:
    frame Z q[1]
  when m[8]:
    prepare |Y+> -> anc[6]
    measure Z q[1] Z anc[6] -> m[10]
    measure X anc[6] -> m[11]
    when m[10]:
      frame Z q[1]
    when m[11]:
      frame Z q[1]
  prepare |T> -> anc[8]
  measure Z q[anc] Z anc[8] -> m[12]
  measure X anc[8] -> m[13]
  when m[13]:
    frame Z q[anc]
  when m[12]:
    prepare |Y+> -> anc[9]
    measure Z q[anc] Z anc[9] -> m[14]
    measure X anc[9] -> m[15]
    when m[14]:
      frame Z q[anc]
    when m[15]:
      frame Z q[anc]
  prepare |T> -> anc[11]
  measure Z q[0] Z q[1] Z anc[11] -> m[16]
  measure X anc[11] -> m[17]
  when m[17]:
    frame Z q[0] Z q[1]
  when m[16]:
    prepare |Y+> -> anc[12]
    measure Z q[0] Z q[1] Z anc[12] -> m[18]
    measure X anc[12] -> m[19]
    when m[18]:
      frame Z q[0] Z q[1]
    when m[19]:
      frame Z q[0] Z q[1]
  prepare |Y+> -> anc[13]
  measure Z q[0] Z q[1] Z anc[13] -> m[20]
  measure X anc[13] -> m[21]
  when m[20]:
    frame Z q[0] Z q[1]
  when m[21]:
    frame Z q[0] Z q[1]
  frame Z q[0] Z q[1]
  prepare |T> -> anc[14]
  measure Z q[0] Z q[anc] Z anc[14] -> m[22]
  measure X anc[14] -> m[23]
  when m[23]:
    frame Z q[0] Z q[anc]
  when m[22]:
    prepare |Y+> -> anc[15]
    measure Z q[0] Z q[anc] Z anc[15] -> m[24]
    measure X anc[15] -> m[25]
    when m[24]:
      frame Z q[0] Z q[anc]
    when m[25]:
      frame Z q[0] Z q[anc]
  prepare |Y+> -> anc[16]
  measure Z q[0] Z q[anc] Z anc[16] -> m[26]
  measure X anc[16] -> m[27]
  when m[26]:
    frame Z q[0] Z q[anc]
  when m[27]:
    frame Z q[0] Z q[anc]
  frame Z q[0] Z q[anc]
  prepare |T> -> anc[17]
  measure Z q[1] Z q[anc] Z anc[17] -> m[28]
  measure X anc[17] -> m[29]
  when m[29]:
    frame Z q[1] Z q[anc]
  when m[28]:
    prepare |Y+> -> anc[18]
    measure Z q[1] Z q[anc] Z anc[18] -> m[30]
    measure X anc[18] -> m[31]
    when m[30]:
      frame Z q[1] Z q[anc]
    when m[31]:
      frame Z q[1] Z q[anc]
  prepare |Y+> -> anc[19]
  measure Z q[1] Z q[anc] Z anc[19] -> m[32]
  measure X anc[19] -> m[33]
  when m[32]:
    frame Z q[1] Z q[anc]
  when m[33]:
    frame Z q[1] Z q[anc]
  frame Z q[1] Z q[anc]
  prepare |T> -> anc[20]
  measure Z q[0] Z q[1] Z q[anc] Z anc[20] -> m[34]
  measure X anc[20] -> m[35]
  when m[35]:
    frame Z q[0] Z q[1] Z q[anc]
  when m[34]:
    prepare |Y+> -> anc[21]
    measure Z q[0] Z q[1] Z q[anc] Z anc[21] -> m[36]
    measure X anc[21] -> m[37]
    when m[36]:
      frame Z q[0] Z q[1] Z q[anc]
    when m[37]:
      frame Z q[0] Z q[1] Z q[anc]
  prepare |Y+> -> anc[23]
  measure X q[anc] Z anc[23] -> m[38]
  measure X anc[23] -> m[39]
  when m[38]:
    frame X q[anc]
  when m[39]:
    frame X q[anc]
  prepare |Y+> -> anc[24]
  measure Z q[anc] Z anc[24] -> m[40]
  measure X anc[24] -> m[41]
  when m[40]:
    frame Z q[anc]
  when m[41]:
    frame Z q[anc]
  for 1 <= j < n-2:
    prepare |Y+> -> anc[25·(j-1)+25]
    measure Z q[anc+j] Z anc[25·(j-1)+25] -> m[42·(j-1)+42]
    measure X anc[25·(j-1)+25] -> m[42·(j-1)+43]
    when m[42·(j-1)+42]:
      frame Z q[anc+j]
    when m[42·(j-1)+43]:
      frame Z q[anc+j]
    prepare |Y+> -> anc[25·(j-1)+26]
    measure X q[anc+j] Z anc[25·(j-1)+26] -> m[42·(j-1)+44]
    measure X anc[25·(j-1)+26] -> m[42·(j-1)+45]
    when m[42·(j-1)+44]:
      frame X q[anc+j]
    when m[42·(j-1)+45]:
      frame X q[anc+j]
    frame Z q[anc+j]
    prepare |T> -> anc[25·(j-1)+27]
    measure Z q[j+1] Z anc[25·(j-1)+27] -> m[42·(j-1)+46]
    measure X anc[25·(j-1)+27] -> m[42·(j-1)+47]
    when m[42·(j-1)+47]:
      frame Z q[j+1]
    when m[42·(j-1)+46]:
      prepare |Y+> -> anc[25·(j-1)+28]
      measure Z q[j+1] Z anc[25·(j-1)+28] -> m[42·(j-1)+48]
      measure X anc[25·(j-1)+28] -> m[42·(j-1)+49]
      when m[42·(j-1)+48]:
        frame Z q[j+1]
      when m[42·(j-1)+49]:
        frame Z q[j+1]
    prepare |T> -> anc[25·(j-1)+30]
    measure Z q[anc+j-1] Z anc[25·(j-1)+30] -> m[42·(j-1)+50]
    measure X anc[25·(j-1)+30] -> m[42·(j-1)+51]
    when m[42·(j-1)+51]:
      frame Z q[anc+j-1]
    when m[42·(j-1)+50]:
      prepare |Y+> -> anc[25·(j-1)+31]
      measure Z q[anc+j-1] Z anc[25·(j-1)+31] -> m[42·(j-1)+52]
      measure X anc[25·(j-1)+31] -> m[42·(j-1)+53]
      when m[42·(j-1)+52]:
        frame Z q[anc+j-1]
      when m[42·(j-1)+53]:
        frame Z q[anc+j-1]
    prepare |T> -> anc[25·(j-1)+33]
    measure Z q[anc+j] Z anc[25·(j-1)+33] -> m[42·(j-1)+54]
    measure X anc[25·(j-1)+33] -> m[42·(j-1)+55]
    when m[42·(j-1)+55]:
      frame Z q[anc+j]
    when m[42·(j-1)+54]:
      prepare |Y+> -> anc[25·(j-1)+34]
      measure Z q[anc+j] Z anc[25·(j-1)+34] -> m[42·(j-1)+56]
      measure X anc[25·(j-1)+34] -> m[42·(j-1)+57]
      when m[42·(j-1)+56]:
        frame Z q[anc+j]
      when m[42·(j-1)+57]:
        frame Z q[anc+j]
    prepare |T> -> anc[25·(j-1)+36]
    measure Z q[j+1] Z q[anc+j-1] Z anc[25·(j-1)+36] -> m[42·(j-1)+58]
    measure X anc[25·(j-1)+36] -> m[42·(j-1)+59]
    when m[42·(j-1)+59]:
      frame Z q[j+1] Z q[anc+j-1]
    when m[42·(j-1)+58]:
      prepare |Y+> -> anc[25·(j-1)+37]
      measure Z q[j+1] Z q[anc+j-1] Z anc[25·(j-1)+37] -> m[42·(j-1)+60]
      measure X anc[25·(j-1)+37] -> m[42·(j-1)+61]
      when m[42·(j-1)+60]:
        frame Z q[j+1] Z q[anc+j-1]
      when m[42·(j-1)+61]:
        frame Z q[j+1] Z q[anc+j-1]
    prepare |Y+> -> anc[25·(j-1)+38]
    measure Z q[j+1] Z q[anc+j-1] Z anc[25·(j-1)+38] -> m[42·(j-1)+62]
    measure X anc[25·(j-1)+38] -> m[42·(j-1)+63]
    when m[42·(j-1)+62]:
      frame Z q[j+1] Z q[anc+j-1]
    when m[42·(j-1)+63]:
      frame Z q[j+1] Z q[anc+j-1]
    frame Z q[j+1] Z q[anc+j-1]
    prepare |T> -> anc[25·(j-1)+39]
    measure Z q[j+1] Z q[anc+j] Z anc[25·(j-1)+39] -> m[42·(j-1)+64]
    measure X anc[25·(j-1)+39] -> m[42·(j-1)+65]
    when m[42·(j-1)+65]:
      frame Z q[j+1] Z q[anc+j]
    when m[42·(j-1)+64]:
      prepare |Y+> -> anc[25·(j-1)+40]
      measure Z q[j+1] Z q[anc+j] Z anc[25·(j-1)+40] -> m[42·(j-1)+66]
      measure X anc[25·(j-1)+40] -> m[42·(j-1)+67]
      when m[42·(j-1)+66]:
        frame Z q[j+1] Z q[anc+j]
      when m[42·(j-1)+67]:
        frame Z q[j+1] Z q[anc+j]
    prepare |Y+> -> anc[25·(j-1)+41]
    measure Z q[j+1] Z q[anc+j] Z anc[25·(j-1)+41] -> m[42·(j-1)+68]
    measure X anc[25·(j-1)+41] -> m[42·(j-1)+69]
    when m[42·(j-1)+68]:
      frame Z q[j+1] Z q[anc+j]
    when m[42·(j-1)+69]:
      frame Z q[j+1] Z q[anc+j]
    frame Z q[j+1] Z q[anc+j]
    prepare |T> -> anc[25·(j-1)+42]
    measure Z q[anc+j-1] Z q[anc+j] Z anc[25·(j-1)+42] -> m[42·(j-1)+70]
    measure X anc[25·(j-1)+42] -> m[42·(j-1)+71]
    when m[42·(j-1)+71]:
      frame Z q[anc+j-1] Z q[anc+j]
    when m[42·(j-1)+70]:
      prepare |Y+> -> anc[25·(j-1)+43]
      measure Z q[anc+j-1] Z q[anc+j] Z anc[25·(j-1)+43] -> m[42·(j-1)+72]
      measure X anc[25·(j-1)+43] -> m[42·(j-1)+73]
      when m[42·(j-1)+72]:
        frame Z q[anc+j-1] Z q[anc+j]
      when m[42·(j-1)+73]:
        frame Z q[anc+j-1] Z q[anc+j]
    prepare |Y+> -> anc[25·(j-1)+44]
    measure Z q[anc+j-1] Z q[anc+j] Z anc[25·(j-1)+44] -> m[42·(j-1)+74]
    measure X anc[25·(j-1)+44] -> m[42·(j-1)+75]
    when m[42·(j-1)+74]:
      frame Z q[anc+j-1] Z q[anc+j]
    when m[42·(j-1)+75]:
      frame Z q[anc+j-1] Z q[anc+j]
    frame Z q[anc+j-1] Z q[anc+j]
    prepare |T> -> anc[25·(j-1)+45]
    measure Z q[j+1] Z q[anc+j-1] Z q[anc+j] Z anc[25·(j-1)+45] -> m[42·(j-1)+76]
    measure X anc[25·(j-1)+45] -> m[42·(j-1)+77]
    when m[42·(j-1)+77]:
      frame Z q[j+1] Z q[anc+j-1] Z q[anc+j]
    when m[42·(j-1)+76]:
      prepare |Y+> -> anc[25·(j-1)+46]
      measure Z q[j+1] Z q[anc+j-1] Z q[anc+j] Z anc[25·(j-1)+46] -> m[42·(j-1)+78]
      measure X anc[25·(j-1)+46] -> m[42·(j-1)+79]
      when m[42·(j-1)+78]:
        frame Z q[j+1] Z q[anc+j-1] Z q[anc+j]
      when m[42·(j-1)+79]:
        frame Z q[j+1] Z q[anc+j-1] Z q[anc+j]
    prepare |Y+> -> anc[25·(j-1)+48]
    measure X q[anc+j] Z anc[25·(j-1)+48] -> m[42·(j-1)+80]
    measure X anc[25·(j-1)+48] -> m[42·(j-1)+81]
    when m[42·(j-1)+80]:
      frame X q[anc+j]
    when m[42·(j-1)+81]:
      frame X q[anc+j]
    prepare |Y+> -> anc[25·(j-1)+49]
    measure Z q[anc+j] Z anc[25·(j-1)+49] -> m[42·(j-1)+82]
    measure X anc[25·(j-1)+49] -> m[42·(j-1)+83]
    when m[42·(j-1)+82]:
      frame Z q[anc+j]
    when m[42·(j-1)+83]:
      frame Z q[anc+j]

