spec groverIterate:
  ∀α .
  requires   2 ≤ n  ∧  s < 2^n  ∧  n ≤ anc  ∧  anc + n ≤ dim
  assumes    {{ Σ x < 2^n . α(x) * (|x⟩_q[0, n) ⊗ |0⟩_q[anc, anc + n - 2)) }}
  ensures {{ Σ x < 2^n . l1Update(n, s, α)(x) * (|x⟩_q[0, n) ⊗ |0⟩_q[anc, anc + n - 2)) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_groverIterate(n, s, anc) + pT * NT_groverIterate(n, s, anc) + pI * N_I)
  outcomes   none
  resource   { meas: 12·n+168·(n-3)+192, frame: 16·n+156·(n-3)+188, magicT: 28·(n-3)+28, synthEps: 0 }

