code surface d=3

params  n

program[q: n, c: 1]:
  for 0 <= i < n:
    measure X q[i] -> m[i]
    when m[i]:
      frame Z q[i]
  for 0 <= i < n - 1:
    measure Z q[i] Z q[i+1] -> m[n+2·i]
    when m[n+2·i]:
      frame X q[i+1]
    measure X q[i] -> m[n+2·i+1]
    when m[n+2·i+1]:
      frame Z q[i+1]
  measure X q[n-1] -> c[0]
