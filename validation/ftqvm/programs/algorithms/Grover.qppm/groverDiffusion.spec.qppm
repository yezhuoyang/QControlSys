spec groverDiffusion:
  ∀α .
  requires   2 ≤ n  ∧  n ≤ anc  ∧  anc + n ≤ dim
  assumes    {{ Σ x < 2^n . α(x) * (|x⟩_q[0, n) ⊗ |0⟩_q[anc, anc + n - 2)) }}
  ensures {{ Σ x < 2^n . grvNegDiffuse(n, α)(x) * (|x⟩_q[0, n) ⊗ |0⟩_q[anc, anc + n - 2)) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_groverDiffusion(n, anc) + pT * NT_groverDiffusion(n, anc) + pI * N_I)
  outcomes   none
  resource   { meas: 12·n+84·(n-3)+96, frame: 14·n+78·(n-3)+94, magicT: 14·(n-3)+14, synthEps: 0 }

