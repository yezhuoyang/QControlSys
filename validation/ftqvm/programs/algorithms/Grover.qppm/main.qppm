program[q: n+rec, c: 2·n+rec]:
  for 0 <= i < n:
    prepare |Y+> -> anc[3·i]
    measure Z q[i] Z anc[3·i] -> m[6·i]
    measure X anc[3·i] -> m[6·i+1]
    when m[6·i]:
      frame Z q[i]
    when m[6·i+1]:
      frame Z q[i]
    prepare |Y+> -> anc[3·i+1]
    measure X q[i] Z anc[3·i+1] -> m[6·i+2]
    measure X anc[3·i+1] -> m[6·i+3]
    when m[6·i+2]:
      frame X q[i]
    when m[6·i+3]:
      frame X q[i]
    prepare |Y+> -> anc[3·i+2]
    measure Z q[i] Z anc[3·i+2] -> m[6·i+4]
    measure X anc[3·i+2] -> m[6·i+5]
    when m[6·i+4]:
      frame Z q[i]
    when m[6·i+5]:
      frame Z q[i]
  for 0 <= r < k:
    groverIterate(n, s, anc) @ id()
  for 0 <= i < n:
    measure Z q[i] -> c[i+n+rec]
    when c[i+n+rec]:
      frame X q[i]

