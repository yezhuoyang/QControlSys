spec andChainRev:
  ∀ x < 2^n . ∀ y < 2^(n - 2) .
  requires   3 ≤ n  ∧  n ≤ anc  ∧  anc + n - 2 ≤ dim
  assumes    {{ |x⟩_q[0, n) ⊗ |andChainOut(n - 2, x, y)⟩_q[anc, anc + n - 2) }}
  ensures {{ |x⟩_q[0, n) ⊗ |y⟩_q[anc, anc + n - 2) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_andChainRev(n, anc) + pT * NT_andChainRev(n, anc) + pI * N_I)
  outcomes   none
  resource   { meas: 42·(n-3)+42, frame: 39·(n-3)+39, magicT: 7·(n-3)+7, synthEps: 0 }

