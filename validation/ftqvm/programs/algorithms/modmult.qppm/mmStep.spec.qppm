spec mmStep:
  ∀ v < N . ∀ d < 2 .
  requires   0 < bits  ∧  0 < N  ∧  (2 * N) ≤ 2^bits
  ∧  j < bits  ∧  0 < (a * 2^j) % N
  ∧  (4 * bits) + 3 ≤ dim
  assumes    {{ |0⟩_q[1] ⊗ |0⟩_q[2] ⊗ |v⟩_q[3, (2 * bits) + 2 : 2)
  ⊗ |0⟩_q[4, (2 * bits) + 3 : 2)
  ⊗ |d⟩_q[(2 * bits) + 3 + j] }}
  ensures {{ |0⟩_q[1] ⊗ |0⟩_q[2] ⊗ |(v + (d * ((a * 2^j) % N))) % N⟩_q[3, (2 * bits) + 2 : 2) ⊗ |0⟩_q[4, (2 * bits) + 3 : 2) ⊗ |d⟩_q[(2 * bits) + 3 + j] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_mmStep(bits, N, a, j) + pT * NT_mmStep(bits, N, a, j) + pI * N_I)
  outcomes   none
  resource   { meas: 436·bits+18, frame: 450·bits+24, magicT: 56·bits, synthEps: 0 }

