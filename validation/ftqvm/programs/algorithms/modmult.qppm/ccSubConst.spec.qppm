spec ccSubConst:
  ∀ x < 2^bits .
  requires   0 < bits  ∧  1 ≤ N  ∧  N ≤ 2^bits  ∧  base + (2 * bits) + 1 ≤ dim
  assumes    {{ |0⟩_q[base] ⊗ |x⟩_q[base+1, base + (2 * bits) : 2)
  ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) }}
  ensures {{ |0⟩_q[base] ⊗ |(x + (2^bits - N)) % 2^bits⟩_q[base+1, base + (2 * bits) : 2) ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ccSubConst(bits, base, N) + pT * NT_ccSubConst(bits, base, N) + pI * N_I)
  outcomes   none
  resource   { meas: 100·bits, frame: 102·bits, magicT: 14·bits, synthEps: 0 }

