spec ccMAJ:
  ∀ u < 2 . ∀ v < 2 . ∀ w < 2 .
  requires   a ≠ b  ∧  a ≠ cw  ∧  b ≠ cw
  ∧  a < dim  ∧  b < dim  ∧  cw < dim
  assumes    {{ |u⟩_q[a] ⊗ |v⟩_q[b] ⊗ |w⟩_q[cw] }}
  ensures {{ |u ⊕ w⟩_q[a] ⊗ |v ⊕ w⟩_q[b] ⊗ |maj3(u, v, w)⟩_q[cw] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ccMAJ(a, b, cw) + pT * NT_ccMAJ(a, b, cw) + pI * N_I)
  outcomes   none
  resource   { meas: 50, frame: 50, magicT: 7, synthEps: 0 }

