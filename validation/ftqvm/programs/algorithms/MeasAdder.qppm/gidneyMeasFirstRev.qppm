gadget gidneyMeasFirstRev(cb):
  prepare |Y+> -> anc[0]
  measure Z q[2] X q[4] Z anc[0] -> m[0]
  measure X anc[0] -> m[1]
  when m[0]:
    frame Z q[2] X q[4]
  when m[1]:
    frame Z q[2] X q[4]
  frame Z q[2]
  prepare |Y+> -> anc[1]
  measure X q[4] Z anc[1] -> m[2]
  measure X anc[1] -> m[3]
  when m[2]:
    frame X q[4]
  when m[3]:
    frame X q[4]
  frame X q[4]
  prepare |Y+> -> anc[2]
  measure Z q[2] X q[3] Z anc[2] -> m[4]
  measure X anc[2] -> m[5]
  when m[4]:
    frame Z q[2] X q[3]
  when m[5]:
    frame Z q[2] X q[3]
  prepare |Y+> -> anc[3]
  measure X q[3] Z anc[3] -> m[6]
  measure X anc[3] -> m[7]
  when m[6]:
    frame X q[3]
  when m[7]:
    frame X q[3]
  frame X q[3]
  prepare |Y+> -> anc[4]
  measure Z q[2] Z anc[4] -> m[8]
  measure X anc[4] -> m[9]
  when m[8]:
    frame Z q[2]
  when m[9]:
    frame Z q[2]
  prepare |Y+> -> anc[5]
  measure X q[2] Z anc[5] -> m[10]
  measure X anc[5] -> m[11]
  when m[10]:
    frame X q[2]
  when m[11]:
    frame X q[2]
  prepare |Y+> -> anc[6]
  measure Z q[2] Z anc[6] -> m[12]
  measure X anc[6] -> m[13]
  when m[12]:
    frame Z q[2]
  when m[13]:
    frame Z q[2]
  measure Z q[2] -> c[cb]
  when c[cb]:
    frame X q[1]
    prepare |Y+> -> anc[7]
    measure Z q[0] Z anc[7] -> m[14]
    measure X anc[7] -> m[15]
    when m[14]:
      frame Z q[0]
    when m[15]:
      frame Z q[0]
    frame Z q[0]
    prepare |Y+> -> anc[8]
    measure Z q[1] Z anc[8] -> m[16]
    measure X anc[8] -> m[17]
    when m[16]:
      frame Z q[1]
    when m[17]:
      frame Z q[1]
    frame Z q[1]
    prepare |Y+> -> anc[9]
    measure Z q[0] Z q[1] Z anc[9] -> m[18]
    measure X anc[9] -> m[19]
    when m[18]:
      frame Z q[0] Z q[1]
    when m[19]:
      frame Z q[0] Z q[1]
    frame X q[1]
    frame X q[2]

