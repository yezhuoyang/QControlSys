spec gidneyForward:
  ∀ x < 2^(3*n) .
  requires   2 ≤ n  ∧  3*n ≤ dim
  assumes    {{ |x⟩_q[0, 3*n) }}
  ensures {{ |vLast(n-1, vFwd(n-2, x))⟩_q[0, 3*n) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_gidneyForward(n) + pT * NT_gidneyForward(n) + pI * N_I)
  outcomes   none
  resource   { meas: 106·(n-1)+48, frame: 108·(n-1)+47, magicT: 14·(n-1)+7, synthEps: 0 }

