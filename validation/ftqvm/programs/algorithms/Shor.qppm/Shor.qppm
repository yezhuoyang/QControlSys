code surface d=3

witness m=4, bits=3, N=3, a=2, ainv=2, rec=19

params  m, bits, N, a, ainv, rec

noise   measure, prepare |Y+>      : Φ~ = N∘Φ, ||(N - id)(ρ)||_1 <= 2·pL·tr(ρ)
        prepare |T>, prepare |CCZ> : Φ~ = N∘Φ, ||(N - id)(ρ)||_1 <= 2·pT·tr(ρ)
        idle                       : ||(N - id)(ρ)||_1 <= 2·pI·tr(ρ)
        frame                      : Φ~ = Φ
        N_L = NL_nparH(m, 0) + (Σ j < m . (18 + NL_ctl_modMulMCP(bits, N, if N = 0 then (a^2^max(0, m - (j + 1))) else (a^2^max(0, m - (j + 1)) % N), if N = 0 then (ainv^2^max(0, m - (j + 1))) else (ainv^2^max(0, m - (j + 1)) % N), 4 * bits + 5, 4 * bits + 6))) + NL_qftInv(m, 0) + NL_measurePhase(m, 0, rec, m + rec)
        N_T = NT_nparH(m, 0) + (Σ j < m . NT_ctl_modMulMCP(bits, N, if N = 0 then (a^2^max(0, m - (j + 1))) else (a^2^max(0, m - (j + 1)) % N), if N = 0 then (ainv^2^max(0, m - (j + 1))) else (ainv^2^max(0, m - (j + 1)) % N), 4 * bits + 5, 4 * bits + 6)) + NT_qftInv(m, 0) + NT_measurePhase(m, 0, rec, m + rec)
        N_I = V
        NL_nparH(n, base) = Σ i < n . 9
        NT_nparH(n, base) = 0
        NL_modMulMCP(bits, N, a, ainv) = NL_encodeAdapter(bits) + NL_modMulInPlace(bits, N, a, ainv) + NL_encodeAdapter(bits)
        NT_modMulMCP(bits, N, a, ainv) = NT_encodeAdapter(bits) + NT_modMulInPlace(bits, N, a, ainv) + NT_encodeAdapter(bits)
        NL_modMulInPlace(bits, N, a, ainv) = NL_modMulConst(bits, N, a) + NL_swapAccMult(bits) + NL_modMulConst(bits, N, if N = 0 then max(0, N - ainv) else (max(0, N - ainv) % N))
        NT_modMulInPlace(bits, N, a, ainv) = NT_modMulConst(bits, N, a) + NT_swapAccMult(bits) + NT_modMulConst(bits, N, if N = 0 then max(0, N - ainv) else (max(0, N - ainv) % N))
        NL_modMulConst(bits, N, a) = Σ w < bits . NL_cAddModN(bits, 2, N, if N = 0 then (a * 2^w) else (a * 2^w % N), 2 * bits + w + 3, 1)
        NT_modMulConst(bits, N, a) = Σ w < bits . NT_cAddModN(bits, 2, N, if N = 0 then (a * 2^w) else (a * 2^w % N), 2 * bits + w + 3, 1)
        NL_cAddModN(bits, base, N, cst, ctrl, flag) = if cst = 0 then 0 else (9 + NL_condAdd(bits, base, cst, ctrl) + NL_compareConst(bits, base, N, flag) + NL_condSub(bits, base, N, flag) + NL_ctrlCompare(bits, base, cst, ctrl, flag))
        NT_cAddModN(bits, base, N, cst, ctrl, flag) = if cst = 0 then 0 else (NT_condAdd(bits, base, cst, ctrl) + NT_compareConst(bits, base, N, flag) + NT_condSub(bits, base, N, flag) + NT_ctrlCompare(bits, base, cst, ctrl, flag))
        NL_condAdd(bits, base, cst, flag) = NL_prepMasked(bits, base, cst, flag) + NL_adder(bits, base) + NL_prepMasked(bits, base, cst, flag)
        NT_condAdd(bits, base, cst, flag) = NT_prepMasked(bits, base, cst, flag) + NT_adder(bits, base) + NT_prepMasked(bits, base, cst, flag)
        NL_adder(n, base) = NL_majChain(n, base) + NL_umaChainRev(n, base)
        NT_adder(n, base) = NT_majChain(n, base) + NT_umaChainRev(n, base)
        NL_majChain(n, base) = Σ k < n . NL_MAJ(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NT_majChain(n, base) = Σ k < n . NT_MAJ(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NL_MAJ(a, b, cw) = 68
        NT_MAJ(a, b, cw) = 7
        NL_umaChainRev(n, base) = Σ k < n . NL_UMA(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NT_umaChainRev(n, base) = Σ k < n . NT_UMA(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NL_UMA(a, b, cw) = 68
        NT_UMA(a, b, cw) = 7
        NL_compareConst(bits, base, N, flag) = 9 + NL_prepConst(bits, base, max(0, 2^bits - N)) + NL_majChain(bits, base) + NL_majChainInv(bits, base) + NL_prepConst(bits, base, max(0, 2^bits - N))
        NT_compareConst(bits, base, N, flag) = NT_prepConst(bits, base, max(0, 2^bits - N)) + NT_majChain(bits, base) + NT_majChainInv(bits, base) + NT_prepConst(bits, base, max(0, 2^bits - N))
        NL_condSub(bits, base, N, flag) = NL_condAdd(bits, base, max(0, 2^bits - N), flag)
        NT_condSub(bits, base, N, flag) = NT_condAdd(bits, base, max(0, 2^bits - N), flag)
        NL_ctrlCompare(bits, base, cst, ctrl, flag) = 9 + NL_prepMasked(bits, base, max(0, 2^bits - cst), ctrl) + NL_majChain(bits, base) + NL_majChainInv(bits, base) + NL_prepMasked(bits, base, max(0, 2^bits - cst), ctrl)
        NT_ctrlCompare(bits, base, cst, ctrl, flag) = NT_prepMasked(bits, base, max(0, 2^bits - cst), ctrl) + NT_majChain(bits, base) + NT_majChainInv(bits, base) + NT_prepMasked(bits, base, max(0, 2^bits - cst), ctrl)
        NL_qftInv(n, base) = (Σ i < n . (9 + (Σ s < i . (synthBits[max(0, i - s) + 2] + synthBits[max(0, i - s) + 2] + synthBits[max(0, i - s) + 2])))) + (Σ i < (n // 2) . NL_swapW(base + i, max(0, base + n - (i + 1))))
        NT_qftInv(n, base) = (Σ i < n . (Σ s < i . (tSynth[max(0, i - s) + 2] + tSynth[max(0, i - s) + 2] + tSynth[max(0, i - s) + 2]))) + (Σ i < (n // 2) . NT_swapW(base + i, max(0, base + n - (i + 1))))
        NL_swapW(a, b) = 27
        NT_swapW(a, b) = 0
        NL_measurePhase(n, base, rec, cb) = Σ i < n . 1
        NT_measurePhase(n, base, rec, cb) = 0
        NL_qubitSwap(a, b) = 27
        NT_qubitSwap(a, b) = 0
        NL_revRegSwap(n, oA, oB) = Σ r < n . NL_qubitSwap(oA + r, oB + max(0, n - (r + 1)))
        NT_revRegSwap(n, oA, oB) = Σ r < n . NT_qubitSwap(oA + r, oB + max(0, n - (r + 1)))
        NL_encodeAdapter(bits) = NL_revRegSwap(bits, 0, 3 * bits + 3)
        NT_encodeAdapter(bits) = NT_revRegSwap(bits, 0, 3 * bits + 3)
        NL_prepMasked(bits, base, cst, flag) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 9 else 0)
        NT_prepMasked(bits, base, cst, flag) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 0 else 0)
        NL_prepConst(bits, base, cst) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 0 else 0)
        NT_prepConst(bits, base, cst) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 0 else 0)
        NL_swapAccMult(bits) = Σ s < bits . NL_qubitSwap(2 * s + 3, 2 * bits + s + 3)
        NT_swapAccMult(bits) = Σ s < bits . NT_qubitSwap(2 * s + 3, 2 * bits + s + 3)
        NL_majChainInv(n, base) = Σ k < n . NL_MAJinv(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NT_majChainInv(n, base) = Σ k < n . NT_MAJinv(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2)
        NL_MAJinv(a, b, cw) = 68
        NT_MAJinv(a, b, cw) = 7
        NL_ctl_swapAccMult(bits, __cw, __anc) = Σ s < bits . NL_ctl_qubitSwap(2 * s + 3, 2 * bits + s + 3, __cw, __anc)
        NT_ctl_swapAccMult(bits, __cw, __anc) = Σ s < bits . NT_ctl_qubitSwap(2 * s + 3, 2 * bits + s + 3, __cw, __anc)
        NL_ctl_ctrlCompare(bits, base, cst, ctrl, flag, __cw, __anc) = 56 + NL_ctl_prepMasked(bits, base, max(0, 2^bits - cst), ctrl, __cw, __anc) + NL_ctl_majChain(bits, base, __cw, __anc) + NL_ctl_majChainInv(bits, base, __cw, __anc) + NL_ctl_prepMasked(bits, base, max(0, 2^bits - cst), ctrl, __cw, __anc)
        NT_ctl_ctrlCompare(bits, base, cst, ctrl, flag, __cw, __anc) = 7 + NT_ctl_prepMasked(bits, base, max(0, 2^bits - cst), ctrl, __cw, __anc) + NT_ctl_majChain(bits, base, __cw, __anc) + NT_ctl_majChainInv(bits, base, __cw, __anc) + NT_ctl_prepMasked(bits, base, max(0, 2^bits - cst), ctrl, __cw, __anc)
        NL_ctl_condSub(bits, base, N, flag, __cw, __anc) = NL_ctl_condAdd(bits, base, max(0, 2^bits - N), flag, __cw, __anc)
        NT_ctl_condSub(bits, base, N, flag, __cw, __anc) = NT_ctl_condAdd(bits, base, max(0, 2^bits - N), flag, __cw, __anc)
        NL_ctl_MAJinv(a, b, cw, __cw, __anc) = 274
        NT_ctl_MAJinv(a, b, cw, __cw, __anc) = 35
        NL_ctl_majChainInv(n, base, __cw, __anc) = Σ k < n . NL_ctl_MAJinv(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NT_ctl_majChainInv(n, base, __cw, __anc) = Σ k < n . NT_ctl_MAJinv(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NL_ctl_prepConst(bits, base, cst, __cw, __anc) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 9 else 0)
        NT_ctl_prepConst(bits, base, cst, __cw, __anc) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 0 else 0)
        NL_ctl_compareConst(bits, base, N, flag, __cw, __anc) = 56 + NL_ctl_prepConst(bits, base, max(0, 2^bits - N), __cw, __anc) + NL_ctl_majChain(bits, base, __cw, __anc) + NL_ctl_majChainInv(bits, base, __cw, __anc) + NL_ctl_prepConst(bits, base, max(0, 2^bits - N), __cw, __anc)
        NT_ctl_compareConst(bits, base, N, flag, __cw, __anc) = 7 + NT_ctl_prepConst(bits, base, max(0, 2^bits - N), __cw, __anc) + NT_ctl_majChain(bits, base, __cw, __anc) + NT_ctl_majChainInv(bits, base, __cw, __anc) + NT_ctl_prepConst(bits, base, max(0, 2^bits - N), __cw, __anc)
        NL_ctl_UMA(a, b, cw, __cw, __anc) = 274
        NT_ctl_UMA(a, b, cw, __cw, __anc) = 35
        NL_ctl_umaChainRev(n, base, __cw, __anc) = Σ k < n . NL_ctl_UMA(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NT_ctl_umaChainRev(n, base, __cw, __anc) = Σ k < n . NT_ctl_UMA(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NL_ctl_MAJ(a, b, cw, __cw, __anc) = 274
        NT_ctl_MAJ(a, b, cw, __cw, __anc) = 35
        NL_ctl_majChain(n, base, __cw, __anc) = Σ k < n . NL_ctl_MAJ(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NT_ctl_majChain(n, base, __cw, __anc) = Σ k < n . NT_ctl_MAJ(base + 2 * k, base + 2 * k + 1, base + 2 * k + 2, __cw, __anc)
        NL_ctl_adder(n, base, __cw, __anc) = NL_ctl_majChain(n, base, __cw, __anc) + NL_ctl_umaChainRev(n, base, __cw, __anc)
        NT_ctl_adder(n, base, __cw, __anc) = NT_ctl_majChain(n, base, __cw, __anc) + NT_ctl_umaChainRev(n, base, __cw, __anc)
        NL_ctl_prepMasked(bits, base, cst, flag, __cw, __anc) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 56 else 0)
        NT_ctl_prepMasked(bits, base, cst, flag, __cw, __anc) = Σ b < bits . (if (cst // 2^b % 2) = 1 then 7 else 0)
        NL_ctl_condAdd(bits, base, cst, flag, __cw, __anc) = NL_ctl_prepMasked(bits, base, cst, flag, __cw, __anc) + NL_ctl_adder(bits, base, __cw, __anc) + NL_ctl_prepMasked(bits, base, cst, flag, __cw, __anc)
        NT_ctl_condAdd(bits, base, cst, flag, __cw, __anc) = NT_ctl_prepMasked(bits, base, cst, flag, __cw, __anc) + NT_ctl_adder(bits, base, __cw, __anc) + NT_ctl_prepMasked(bits, base, cst, flag, __cw, __anc)
        NL_ctl_cAddModN(bits, base, N, cst, ctrl, flag, __cw, __anc) = if cst = 0 then 0 else (56 + NL_ctl_condAdd(bits, base, cst, ctrl, __cw, __anc) + NL_ctl_compareConst(bits, base, N, flag, __cw, __anc) + NL_ctl_condSub(bits, base, N, flag, __cw, __anc) + NL_ctl_ctrlCompare(bits, base, cst, ctrl, flag, __cw, __anc))
        NT_ctl_cAddModN(bits, base, N, cst, ctrl, flag, __cw, __anc) = if cst = 0 then 0 else (7 + NT_ctl_condAdd(bits, base, cst, ctrl, __cw, __anc) + NT_ctl_compareConst(bits, base, N, flag, __cw, __anc) + NT_ctl_condSub(bits, base, N, flag, __cw, __anc) + NT_ctl_ctrlCompare(bits, base, cst, ctrl, flag, __cw, __anc))
        NL_ctl_modMulConst(bits, N, a, __cw, __anc) = Σ w < bits . NL_ctl_cAddModN(bits, 2, N, if N = 0 then (a * 2^w) else (a * 2^w % N), 2 * bits + w + 3, 1, __cw, __anc)
        NT_ctl_modMulConst(bits, N, a, __cw, __anc) = Σ w < bits . NT_ctl_cAddModN(bits, 2, N, if N = 0 then (a * 2^w) else (a * 2^w % N), 2 * bits + w + 3, 1, __cw, __anc)
        NL_ctl_modMulInPlace(bits, N, a, ainv, __cw, __anc) = NL_ctl_modMulConst(bits, N, a, __cw, __anc) + NL_ctl_swapAccMult(bits, __cw, __anc) + NL_ctl_modMulConst(bits, N, if N = 0 then max(0, N - ainv) else (max(0, N - ainv) % N), __cw, __anc)
        NT_ctl_modMulInPlace(bits, N, a, ainv, __cw, __anc) = NT_ctl_modMulConst(bits, N, a, __cw, __anc) + NT_ctl_swapAccMult(bits, __cw, __anc) + NT_ctl_modMulConst(bits, N, if N = 0 then max(0, N - ainv) else (max(0, N - ainv) % N), __cw, __anc)
        NL_ctl_qubitSwap(a, b, __cw, __anc) = 162
        NT_ctl_qubitSwap(a, b, __cw, __anc) = 21
        NL_ctl_revRegSwap(n, oA, oB, __cw, __anc) = Σ r < n . NL_ctl_qubitSwap(oA + r, oB + max(0, n - (r + 1)), __cw, __anc)
        NT_ctl_revRegSwap(n, oA, oB, __cw, __anc) = Σ r < n . NT_ctl_qubitSwap(oA + r, oB + max(0, n - (r + 1)), __cw, __anc)
        NL_ctl_encodeAdapter(bits, __cw, __anc) = NL_ctl_revRegSwap(bits, 0, 3 * bits + 3, __cw, __anc)
        NT_ctl_encodeAdapter(bits, __cw, __anc) = NT_ctl_revRegSwap(bits, 0, 3 * bits + 3, __cw, __anc)
        NL_ctl_modMulMCP(bits, N, a, ainv, __cw, __anc) = 18 + NL_ctl_encodeAdapter(bits, __cw, __anc) + NL_ctl_modMulInPlace(bits, N, a, ainv, 3 * bits + 3, 3 * bits + 4) + NL_ctl_encodeAdapter(bits, __cw, __anc)
        NT_ctl_modMulMCP(bits, N, a, ainv, __cw, __anc) = NT_ctl_encodeAdapter(bits, __cw, __anc) + NT_ctl_modMulInPlace(bits, N, a, ainv, 3 * bits + 3, 3 * bits + 4) + NT_ctl_encodeAdapter(bits, __cw, __anc)

define bit(e, k)           = (e >> k) % 2
define popc(n, x)                  = Σ b < n . bit(x, b)
define nz(x)                       = if x = 0 then 0 else 1
define maj3(u, v, w)               = w ⊕ ((u ⊕ w) * (v ⊕ w))
define cmpGE(x, y)                 = if y ≤ x then 1 else 0
define xorN(0, x, y)               = 0
define xorN(k+1, x, y)             = xorN(k, x, y) + ((bit(x, k) ⊕ bit(y, k)) * 2^k)
define revBits(0, w, x)            = 0
define revBits(k+1, w, x)          = revBits(k, w, x) + (bit(x, k) * 2^(w - 1 - k))
define rev(w, x)                   = revBits(w, w, x)
define carryAt(0, u, v, cin)       = cin
define carryAt(k+1, u, v, cin)     = maj3(carryAt(k, u, v, cin), bit(v, k), bit(u, k))
define majWord(n, u, v, cin)       = Σ i < n . ((carryAt(i, u, v, cin) ⊕ bit(u, i)) * 2^i)
define Order(a, r, N)              = 0 < r  ∧  a^r % N = 1
  ∧  (∀ s < r . 0 < s → a^s % N ≠ 1)
define BasicSetting(a, r, N, m, n) = 0 < a  ∧  a < N  ∧  Order(a, r, N)
  ∧  N^2 < 2^m  ∧  2^m ≤ 2 * N^2  ∧  N < 2^n
define CircuitSizing(N, n)         = 1 ≤ n  ∧  2 * N ≤ 2^n
define modexpF(a, x, N)            = a^x % N
define cfDen(0, o, d, qp, qc)      = qc
define cfDen(k+1, o, d, qp, qc)    = if d = 0 then qc
  else cfDen(k, d, o % d, qc, ((o // d) * qc) + qp)
define cfStep(s, o, m)             = cfDen(s + 1, o, 2^m, 1, 0)
define ofIter(0, a, N, o, m)       = 0
define ofIter(k+1, a, N, o, m)     = if ofIter(k, a, N, o, m) ≠ 0
  then ofIter(k, a, N, o, m)
  else (if modexpF(a, cfStep(k, o, m), N) = 1
  then cfStep(k, o, m)
  else 0)
define ofPost(a, N, o, m)          = ofIter((2 * m) + 2, a, N, o, m)
define rFound(o, m, r, a, N)       = ofPost(a, N, rev(m, o), m) = r
define cAddCliff(n, N, cst)        = nz(cst) * ((16 * n) + 3 + (2 * popc(n, cst))
  + (4 * popc(n, 2^n - N))
  + (2 * popc(n, 2^n - cst)))
define nzCnt(n, N, cst)            = Σ w < n . nz((cst * 2^w) % N)
define mcTof(n, N, cst)            = 8 * n * nzCnt(n, N, cst)
define mcCliff(n, N, cst)          = Σ w < n . cAddCliff(n, N, (cst * 2^w) % N)
define mmTof(n, N, cst, d)         = mcTof(n, N, cst) + mcTof(n, N, (N - d) % N)
define mipCliff(n, N, cst, d)      = (3 * n) + mcCliff(n, N, cst) + mcCliff(n, N, (N - d) % N)
define mmCliff(n, N, cst, d)       = (6 * n) + mipCliff(n, N, cst, d)
define cAddX(n, N, cst)            = nz(cst) * (2 * popc(n, 2^n - N))
define cAddCX(n, N, cst)           = nz(cst) * ((16 * n) + 3 + (2 * popc(n, cst))
  + (2 * popc(n, 2^n - N))
  + (2 * popc(n, 2^n - cst)))
define mcX(n, N, cst)              = 2 * popc(n, 2^n - N) * nzCnt(n, N, cst)
define mcCX(n, N, cst)             = Σ w < n . cAddCX(n, N, (cst * 2^w) % N)
define mipX(n, N, cst, d)          = mcX(n, N, cst) + mcX(n, N, (N - d) % N)
define mipCX(n, N, cst, d)         = (3 * n) + mcCX(n, N, cst) + mcCX(n, N, (N - d) % N)
define mmX(n, N, cst, d)           = mipX(n, N, cst, d)
define mmCX(n, N, cst, d)          = (6 * n) + mipCX(n, N, cst, d)
define iqftCells(n)                = (n * (n - 1)) // 2
define iqftCliff(n)                = n + (2 * iqftCells(n)) + (3 * (n // 2))
define iqftRot(n)                  = (n - 1) * (n - 2)
define iqftT(n)                    = 2 * (n - 1)
define iqftOps(n)                  = iqftCliff(n) + iqftRot(n)
define powStep(x, N, m, j)         = x^(2^(m - 1 - j)) % N
define shorTof(m, bits, N, a, ainv) = Σ j < m . mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))
define shorCliff(m, bits, N, a, ainv) = Σ j < m . mmCliff(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))
define shorOps(m, bits, N, a, ainv) = Σ j < m . (mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))
  + mmCliff(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j)))
define shorCtrlTof(m, bits, N, a, ainv)   = Σ j < m . (mmCX(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))
  + (6 * mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))))
define shorCtrlT(m, bits, N, a, ainv)     = Σ j < m . ((7 * mmCX(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j)))
  + (42 * mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))))
define shorCtrlCliff(m, bits, N, a, ainv) = Σ j < m . (mmX(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))
  + (18 * mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j))))
define shorCtrlRot(m, bits, N, a, ainv)   = Σ j < m . (36 * mmTof(bits, N, powStep(a, N, m, j),
  powStep(ainv, N, m, j)))
define shorCtrlOps(m, bits, N, a, ainv)   = shorCtrlTof(m, bits, N, a, ainv)
  + shorCtrlCliff(m, bits, N, a, ainv)

