spec modMulMCP:
  ∀ u < N .
  requires   1 ≤ bits  ∧  0 < N  ∧  2 * N ≤ 2^bits
  ∧  0 < ainv  ∧  ainv ≤ N  ∧  (a * ainv) % N = 1
  ∧  (4 * bits) + 3 ≤ dim
  assumes    {{ |rev(bits, u)⟩_q[0, bits) ⊗ |0⟩_q[bits, (4 * bits) + 3) }}
  ensures {{ |rev(bits, (a * u) % N)⟩_q[0, bits) ⊗ |0⟩_q[bits, (4 * bits) + 3) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_modMulMCP(bits, N, a, ainv) + pT * NT_modMulMCP(bits, N, a, ainv) + pI * N_I)
  outcomes   none
  resource   { meas: 90·bits+872·bits^(2), frame: 120·bits+900·bits^(2), magicT: 112·bits^(2), synthEps: 0 }

