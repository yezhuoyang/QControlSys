gadget nparH(n, base):
  for 0 <= i < n:
    prepare |Y+> -> anc[3·i]
    measure Z q[base+i] Z anc[3·i] -> m[6·i]
    measure X anc[3·i] -> m[6·i+1]
    when m[6·i]:
      frame Z q[base+i]
    when m[6·i+1]:
      frame Z q[base+i]
    prepare |Y+> -> anc[3·i+1]
    measure X q[base+i] Z anc[3·i+1] -> m[6·i+2]
    measure X anc[3·i+1] -> m[6·i+3]
    when m[6·i+2]:
      frame X q[base+i]
    when m[6·i+3]:
      frame X q[base+i]
    prepare |Y+> -> anc[3·i+2]
    measure Z q[base+i] Z anc[3·i+2] -> m[6·i+4]
    measure X anc[3·i+2] -> m[6·i+5]
    when m[6·i+4]:
      frame Z q[base+i]
    when m[6·i+5]:
      frame Z q[base+i]

