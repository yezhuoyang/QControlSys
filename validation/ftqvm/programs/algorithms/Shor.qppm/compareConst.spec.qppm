spec compareConst:
  ∀ u < 2^bits . ∀ f < 2 .
  requires   0 < N  ∧  N ≤ 2^bits
  ∧  (flag < base  ∨  base + (2 * bits) + 1 ≤ flag)
  ∧  base + (2 * bits) + 1 ≤ dim  ∧  flag < dim
  assumes    {{ |0⟩_q[base] ⊗ |u⟩_q[base+1, base + (2 * bits) : 2)
  ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |f⟩_q[flag] }}
  ensures {{ |0⟩_q[base] ⊗ |u⟩_q[base+1, base + (2 * bits) : 2) ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |f ⊕ cmpGE(u, N)⟩_q[flag] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_compareConst(bits, base, N, flag) + pT * NT_compareConst(bits, base, N, flag) + pI * N_I)
  outcomes   none
  resource   { meas: 100·bits+6, frame: 102·bits+8, magicT: 14·bits, synthEps: 0 }

