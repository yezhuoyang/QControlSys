gadget cAddModN(bits, base, N, cst, ctrl, flag):
  if not cst = 0:
    condAdd(bits, base, cst, ctrl) @ id()
    compareConst(bits, base, N, flag) @ id()
    condSub(bits, base, N, flag) @ id()
    ctrlCompare(bits, base, cst, ctrl, flag) @ id()
    prepare |Y+> -> anc[0]
    measure Z q[ctrl] X q[flag] Z anc[0] -> m[0]
    measure X anc[0] -> m[1]
    when m[0]:
      frame Z q[ctrl] X q[flag]
    when m[1]:
      frame Z q[ctrl] X q[flag]
    prepare |Y+> -> anc[1]
    measure Z q[ctrl] Z anc[1] -> m[2]
    measure X anc[1] -> m[3]
    when m[2]:
      frame Z q[ctrl]
    when m[3]:
      frame Z q[ctrl]
    frame Z q[ctrl]
    prepare |Y+> -> anc[2]
    measure X q[flag] Z anc[2] -> m[4]
    measure X anc[2] -> m[5]
    when m[4]:
      frame X q[flag]
    when m[5]:
      frame X q[flag]
    frame X q[flag]

