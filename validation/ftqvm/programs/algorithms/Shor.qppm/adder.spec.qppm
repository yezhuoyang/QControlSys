spec adder:
  ∀ u < 2^n . ∀ v < 2^n .
  requires   0 < n  ∧  base + (2 * n) + 1 ≤ dim
  assumes    {{ |0⟩_q[base] ⊗ |v⟩_q[base+1, base + (2 * n) : 2)
  ⊗ |u⟩_q[base+2, base + (2 * n) + 1 : 2) }}
  ensures {{ |0⟩_q[base] ⊗ |(u + v) % 2^n⟩_q[base+1, base + (2 * n) : 2) ⊗ |u⟩_q[base+2, base + (2 * n) + 1 : 2) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_adder(n, base) + pT * NT_adder(n, base) + pI * N_I)
  outcomes   none
  resource   { meas: 100·n, frame: 100·n, magicT: 14·n, synthEps: 0 }

