spec program:
  ∀ r < N .
  requires   BasicSetting(a, r, N, m, bits)
  →  0 < m
  ∧  CircuitSizing(N, bits)
  ∧  (a * ainv) % N = 1
  ∧  m + (4 * bits) + 3 ≤ rec
  ∧  rec + m + m ≤ dim
  ∧  a % N ≠ 1
  assumes    {{ |0⟩_q[0, m) ⊗ |rev(bits, 1)⟩_q[m, m+bits) ⊗ |0⟩_q[m+bits, dim) }}
  ensures {{ |0⟩_q[0, m) ⊗ |0⟩_q[m+bits, m + (4 * bits) + 3) ⊗ |0⟩_q[m + (4 * bits) + 3, rec + m) }}  within ||Tr_anc(.)||_1 <= (Σ rv_i < m . (Σ rv_s < rv_i . 3·synthEps[rv_i-rv_s+2])) + 2 * (pL * N_L + pT * N_T + pI * N_I)
  outcomes Pr[ rFound(c[0, m), m, r, a, N) ]  ≥  (4 / (pi^2 * (Σ k < ilog2(N) + 1 . (if (Π i < k + 1 . (i + 1)) ≤ N then 1 else 0)))) - (Σ rv_i < m . (Σ rv_s < rv_i . 3·synthEps[rv_i-rv_s+2])) - (pL * N_L + pT * N_T + pI * N_I)
  resource   { meas: 618·(bits·m)+3824·(bits^(2)·m)+37·m+18·(m/2), frame: 576·(bits·m)+3572·(bits^(2)·m)+45·m+24·(m/2), magicT: (Σ rv_i < m . (Σ rv_s < rv_i . 3·tSynth[rv_i-rv_s+2]))+105·(bits·m)+644·(bits^(2)·m), synthEps: (Σ rv_i < m . (Σ rv_s < rv_i . 3·synthEps[rv_i-rv_s+2])), bound: upper }
