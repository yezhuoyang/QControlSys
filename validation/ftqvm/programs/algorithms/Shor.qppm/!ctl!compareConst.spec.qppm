spec !ctl!compareConst:
  ensures    unspecified  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ctl_compareConst(bits, base, N, flag, __cw, __anc) + pT * NT_ctl_compareConst(bits, base, N, flag, __cw, __anc) + pI * N_I)
