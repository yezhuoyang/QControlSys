spec qubitSwap:
  ∀ u < 2 . ∀ v < 2 .
  requires   a ≠ b  ∧  a < dim  ∧  b < dim
  assumes    {{ |u⟩_q[a] ⊗ |v⟩_q[b] }}
  ensures {{ |v⟩_q[a] ⊗ |u⟩_q[b] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_qubitSwap(a, b) + pT * NT_qubitSwap(a, b) + pI * N_I)
  outcomes   none
  resource   { meas: 18, frame: 24, magicT: 0, synthEps: 0 }

