gadget MAJ(a, b, cw):
  prepare |Y+> -> anc[0]
  measure Z q[cw] X q[b] Z anc[0] -> m[0]
  measure X anc[0] -> m[1]
  when m[0]:
    frame Z q[cw] X q[b]
  when m[1]:
    frame Z q[cw] X q[b]
  frame Z q[cw]
  prepare |Y+> -> anc[1]
  measure X q[b] Z anc[1] -> m[2]
  measure X anc[1] -> m[3]
  when m[2]:
    frame X q[b]
  when m[3]:
    frame X q[b]
  frame X q[b]
  prepare |Y+> -> anc[2]
  measure Z q[cw] X q[a] Z anc[2] -> m[4]
  measure X anc[2] -> m[5]
  when m[4]:
    frame Z q[cw] X q[a]
  when m[5]:
    frame Z q[cw] X q[a]
  prepare |Y+> -> anc[3]
  measure X q[a] Z anc[3] -> m[6]
  measure X anc[3] -> m[7]
  when m[6]:
    frame X q[a]
  when m[7]:
    frame X q[a]
  frame X q[a]
  prepare |Y+> -> anc[4]
  measure Z q[cw] Z anc[4] -> m[8]
  measure X anc[4] -> m[9]
  when m[8]:
    frame Z q[cw]
  when m[9]:
    frame Z q[cw]
  prepare |Y+> -> anc[5]
  measure X q[cw] Z anc[5] -> m[10]
  measure X anc[5] -> m[11]
  when m[10]:
    frame X q[cw]
  when m[11]:
    frame X q[cw]
  frame Z q[cw]
  prepare |T> -> anc[6]
  measure Z q[a] Z anc[6] -> m[12]
  measure X anc[6] -> m[13]
  when m[13]:
    frame Z q[a]
  when m[12]:
    prepare |Y+> -> anc[7]
    measure Z q[a] Z anc[7] -> m[14]
    measure X anc[7] -> m[15]
    when m[14]:
      frame Z q[a]
    when m[15]:
      frame Z q[a]
  prepare |T> -> anc[9]
  measure Z q[b] Z anc[9] -> m[16]
  measure X anc[9] -> m[17]
  when m[17]:
    frame Z q[b]
  when m[16]:
    prepare |Y+> -> anc[10]
    measure Z q[b] Z anc[10] -> m[18]
    measure X anc[10] -> m[19]
    when m[18]:
      frame Z q[b]
    when m[19]:
      frame Z q[b]
  prepare |T> -> anc[12]
  measure Z q[cw] Z anc[12] -> m[20]
  measure X anc[12] -> m[21]
  when m[21]:
    frame Z q[cw]
  when m[20]:
    prepare |Y+> -> anc[13]
    measure Z q[cw] Z anc[13] -> m[22]
    measure X anc[13] -> m[23]
    when m[22]:
      frame Z q[cw]
    when m[23]:
      frame Z q[cw]
  prepare |T> -> anc[15]
  measure Z q[a] Z q[b] Z anc[15] -> m[24]
  measure X anc[15] -> m[25]
  when m[25]:
    frame Z q[a] Z q[b]
  when m[24]:
    prepare |Y+> -> anc[16]
    measure Z q[a] Z q[b] Z anc[16] -> m[26]
    measure X anc[16] -> m[27]
    when m[26]:
      frame Z q[a] Z q[b]
    when m[27]:
      frame Z q[a] Z q[b]
  prepare |Y+> -> anc[17]
  measure Z q[a] Z q[b] Z anc[17] -> m[28]
  measure X anc[17] -> m[29]
  when m[28]:
    frame Z q[a] Z q[b]
  when m[29]:
    frame Z q[a] Z q[b]
  frame Z q[a] Z q[b]
  prepare |T> -> anc[18]
  measure Z q[a] Z q[cw] Z anc[18] -> m[30]
  measure X anc[18] -> m[31]
  when m[31]:
    frame Z q[a] Z q[cw]
  when m[30]:
    prepare |Y+> -> anc[19]
    measure Z q[a] Z q[cw] Z anc[19] -> m[32]
    measure X anc[19] -> m[33]
    when m[32]:
      frame Z q[a] Z q[cw]
    when m[33]:
      frame Z q[a] Z q[cw]
  prepare |Y+> -> anc[20]
  measure Z q[a] Z q[cw] Z anc[20] -> m[34]
  measure X anc[20] -> m[35]
  when m[34]:
    frame Z q[a] Z q[cw]
  when m[35]:
    frame Z q[a] Z q[cw]
  frame Z q[a] Z q[cw]
  prepare |T> -> anc[21]
  measure Z q[b] Z q[cw] Z anc[21] -> m[36]
  measure X anc[21] -> m[37]
  when m[37]:
    frame Z q[b] Z q[cw]
  when m[36]:
    prepare |Y+> -> anc[22]
    measure Z q[b] Z q[cw] Z anc[22] -> m[38]
    measure X anc[22] -> m[39]
    when m[38]:
      frame Z q[b] Z q[cw]
    when m[39]:
      frame Z q[b] Z q[cw]
  prepare |Y+> -> anc[23]
  measure Z q[b] Z q[cw] Z anc[23] -> m[40]
  measure X anc[23] -> m[41]
  when m[40]:
    frame Z q[b] Z q[cw]
  when m[41]:
    frame Z q[b] Z q[cw]
  frame Z q[b] Z q[cw]
  prepare |T> -> anc[24]
  measure Z q[a] Z q[b] Z q[cw] Z anc[24] -> m[42]
  measure X anc[24] -> m[43]
  when m[43]:
    frame Z q[a] Z q[b] Z q[cw]
  when m[42]:
    prepare |Y+> -> anc[25]
    measure Z q[a] Z q[b] Z q[cw] Z anc[25] -> m[44]
    measure X anc[25] -> m[45]
    when m[44]:
      frame Z q[a] Z q[b] Z q[cw]
    when m[45]:
      frame Z q[a] Z q[b] Z q[cw]
  prepare |Y+> -> anc[27]
  measure X q[cw] Z anc[27] -> m[46]
  measure X anc[27] -> m[47]
  when m[46]:
    frame X q[cw]
  when m[47]:
    frame X q[cw]
  prepare |Y+> -> anc[28]
  measure Z q[cw] Z anc[28] -> m[48]
  measure X anc[28] -> m[49]
  when m[48]:
    frame Z q[cw]
  when m[49]:
    frame Z q[cw]

