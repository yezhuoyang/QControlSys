spec ccCondAdd:
  ∀ x < 2^bits . ∀ d < 2 .
  requires   0 < bits  ∧  cst < 2^bits  ∧  base + (2 * bits) + 1 ≤ dim  ∧  ctl < dim
  ∧  (∀ i < bits . ctl ≠ base + (2 * i) + 2)
  assumes    {{ |0⟩_q[base] ⊗ |x⟩_q[base+1, base + (2 * bits) : 2)
  ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |d⟩_q[ctl] }}
  ensures {{ |0⟩_q[base] ⊗ |(x + (d * cst)) % 2^bits⟩_q[base+1, base + (2 * bits) : 2) ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |d⟩_q[ctl] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ccCondAdd(bits, base, cst, ctl) + pT * NT_ccCondAdd(bits, base, cst, ctl) + pI * N_I)
  outcomes   none
  resource   { meas: 112·bits, frame: 116·bits, magicT: 14·bits, synthEps: 0 }

