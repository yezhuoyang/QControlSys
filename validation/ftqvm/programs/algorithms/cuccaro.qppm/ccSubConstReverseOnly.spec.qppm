spec ccSubConstReverseOnly:
  ∀ x < 2^bits .
  requires   0 < bits  ∧  0 < N  ∧  N ≤ 2^bits  ∧  base + (2 * bits) + 1 ≤ dim
  assumes    {{ |majWord(bits, 2^bits - N, x, 0)⟩_q[base, base + (2 * bits) : 2)
  ⊗ |xorN(bits, 2^bits - N, x)⟩_q[base+1, base + (2 * bits) : 2)
  ⊗ |carryAt(bits, 2^bits - N, x, 0)⟩_q[base + (2 * bits)] }}
  ensures {{ |0⟩_q[base] ⊗ |(x + (2^bits - N)) % 2^bits⟩_q[base+1, base + (2 * bits) : 2) ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ccSubConstReverseOnly(bits, base, N) + pT * NT_ccSubConstReverseOnly(bits, base, N) + pI * N_I)
  outcomes   none
  resource   { meas: 50·bits, frame: 51·bits, magicT: 7·bits, synthEps: 0 }

