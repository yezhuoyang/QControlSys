spec ccModAddDirty:
  ∀ x < N .
  requires   0 < bits  ∧  0 < N  ∧  (2 * N) ≤ 2^bits  ∧  cst < N
  ∧  base + (2 * bits) + 1 ≤ dim  ∧  flag < dim
  ∧  flag ≠ base  ∧  flag ≠ base + (2 * bits)
  ∧  (∀ i < bits . flag ≠ base + (2 * i) + 1)
  ∧  (∀ i < bits . flag ≠ base + (2 * i) + 2)
  assumes    {{ |0⟩_q[base] ⊗ |x⟩_q[base+1, base + (2 * bits) : 2)
  ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |0⟩_q[flag] }}
  ensures {{ |0⟩_q[base] ⊗ |(x + cst) % N⟩_q[base+1, base + (2 * bits) : 2) ⊗ |0⟩_q[base+2, base + (2 * bits) + 1 : 2) ⊗ |cmpGE(x + cst, N)⟩_q[flag] }}  within ||Tr_anc(.)||_1 <= 2 * (pL * NL_ccModAddDirty(bits, base, N, cst, flag) + pT * NT_ccModAddDirty(bits, base, N, cst, flag) + pI * N_I)
  outcomes   none
  resource   { meas: 312·bits+6, frame: 320·bits+8, magicT: 42·bits, synthEps: 0 }

